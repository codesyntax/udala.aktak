<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:browser="http://namespaces.zope.org/browser"
    xmlns:plone="http://namespaces.plone.org/plone"
    i18n_domain="udala.aktak"
    >

  <browser:page
      name="view"
      for="udala.aktak.content.bilkura.IBilkura"
      class=".meeting_view.MeetingView"
      template="meeting_view.pt"
      permission="zope2.View"
      layer="udala.aktak.interfaces.IBrowserLayer"
      />

  <browser:page
      name="bilkurak-filter-view"
      for="plone.app.contenttypes.interfaces.IFolder"
      class=".meetings_view.MeetingsView"
      template="meetings_filters_view.pt"
      permission="zope2.View"
      layer="udala.aktak.interfaces.IBrowserLayer"
      menu="plone_displayviews"
      title="Meeting listing (filters and complete data)"
      />

  <browser:page
      name="bilkurak-aktak-bakarrik-filter-view"
      for="plone.app.contenttypes.interfaces.IFolder"
      class=".meetings_view.MeetingsView"
      template="meetings_filters_only_minutes_view.pt"
      permission="zope2.View"
      layer="udala.aktak.interfaces.IBrowserLayer"
      menu="plone_displayviews"
      title="Meeting listing (filters and minutes only)"
      />

  <browser:page
      name="bilkurak-view"
      for="plone.app.contenttypes.interfaces.IFolder"
      class=".meetings_view.MeetingsView"
      template="meetings_view.pt"
      permission="zope2.View"
      layer="udala.aktak.interfaces.IBrowserLayer"
      menu="plone_displayviews"
      title="Meeting listing (only from this folder with complete data)"
      />

  <browser:page
      name="bilkurak-aktak-bakarrik-view"
      for="plone.app.contenttypes.interfaces.IFolder"
      class=".meetings_view.MeetingsView"
      template="meetings_only_minutes_view.pt"
      permission="zope2.View"
      layer="udala.aktak.interfaces.IBrowserLayer"
      menu="plone_displayviews"
      title="Meeting listing (only from this folder minutes only"
      />
</configure>
