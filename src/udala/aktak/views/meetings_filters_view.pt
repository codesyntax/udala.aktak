<html xmlns="http://www.w3.org/1999/xhtml"
      xmlns:i18n="http://xml.zope.org/namespaces/i18n"
      xmlns:metal="http://xml.zope.org/namespaces/metal"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      metal:use-macro="context/main_template/macros/master"
      i18n:domain="udala.aktak"
>

  <body>

    <metal:content-core fill-slot="content-core">
      <metal:block define-macro="content-core">

        <tal:contents tal:define="
                        folders context/@@contentlisting;
                        toLocalizedTime nocall:context/@@plone/toLocalizedTime;
                        icons python:context.restrictedTraverse('@@iconresolver');
                      ">

          <div class="plone-javascripts">
            <script type="text/javascript">
            document.addEventListener('DOMContentLoaded', function () {
              var folderChangeElement = document.getElementById('folder-change');
              folderChangeElement.addEventListener('change', function () {
                var visibleTables = document.querySelectorAll('.filter-table-container');
                visibleTables.forEach(function (table) {
                  table.style.display = 'none';
                });

                var showfolder = folderChangeElement.value;
                var folderToShow = document.getElementById(showfolder);
                if (folderToShow) {
                  folderToShow.style.display = 'block';
                }
              });
            });
            </script>
          </div>

          <div class="mb-4 col-md-4 col-lg-3">
            <label class="form-label text-secondary fw-medium small mb-1"
                   for="folder-change"
                   i18n:translate=""
            >Filter by year</label>
            <select class="form-select shadow-sm"
                    id="folder-change"
            >
              <option tal:repeat="folder folders"
                      tal:content="folder/title"
                      tal:attributes="
                        value folder/id;
                      "
              >
              </option>
            </select>
          </div>

          <tal:repeat tal:repeat="folder folders">
            <div class="card shadow-sm border-0 mb-4 filter-table-container"
                 tal:attributes="
                   id folder/id;
                   style python:repeat['folder'].index==0 and 'display:block' or 'display:none';
                 "
            >
              <div class="table-responsive m-0">

                <table class="table table-hover table-striped mb-0 align-middle"
                       id="meetings"
                >
                  <thead class="table-light text-secondary">
                    <tr>
                      <th class="fw-semibold border-bottom-0 py-3 ps-4"
                          i18n:translate=""
                      >Date</th>
                      <th class="fw-semibold border-bottom-0 py-3"
                          i18n:translate=""
                      >Type</th>
                      <th class="fw-semibold border-bottom-0 py-3"
                          i18n:translate=""
                      >Agenda</th>
                      <th class="fw-semibold border-bottom-0 py-3"
                          i18n:translate=""
                      >Meeting minutes</th>
                      <th class="fw-semibold border-bottom-0 py-3"
                          i18n:translate=""
                      >Annexes to the meeting minutes</th>
                      <th class="fw-semibold border-bottom-0 py-3 text-center"
                          i18n:translate=""
                      >Video</th>
                      <th class="fw-semibold border-bottom-0 py-3 pe-4 text-center"
                          i18n:translate=""
                      >Video-minutes</th>
                    </tr>
                  </thead>
                  <tbody class="border-top-0">
                    <tr tal:define="
                          folder_object python:folder.getObject();
                        "
                        tal:repeat="brain python:folder_object.restrictedTraverse('@@contentlisting')(sort_on='meeting_date', sort_order='reverse')"
                    >
                      <tal:item define="
                                  item python:brain.getObject();
                                  item_url item/absolute_url;
                                ">
                        <td class="ps-4 fw-medium text-dark"
                            tal:content="python:toLocalizedTime(item.meeting_date)"
                        >
                          2022/04/04 19:00
                        </td>
                        <td class="text-secondary"
                            tal:content="item/get_meeting_type_title"
                        >Ordinary</td>
                        <td>
                          <tal:block tal:condition="item/meeting_agenda">
                            <a class="btn btn-sm btn-outline-primary d-inline-flex align-items-center gap-1 rounded-pill px-3"
                               title="Download"
                               tal:attributes="
                                 href string:${item_url}/@@download/meeting_agenda;
                               "
                               i18n:attributes="title"
                            >
                              <span class="d-flex align-items-center"
                                    tal:content="structure python:icons.tag('download')"
                              ></span>
                              <span i18n:translate="">Download</span>
                            </a>
                          </tal:block>
                        </td>
                        <td>
                          <tal:block tal:condition="item/meeting_minutes">
                            <a class="btn btn-sm btn-outline-primary d-inline-flex align-items-center gap-1 rounded-pill px-3"
                               title="Download"
                               tal:attributes="
                                 href string:${item_url}/@@download/meeting_minutes;
                               "
                               i18n:attributes="title"
                            >
                              <span class="d-flex align-items-center"
                                    tal:content="structure python:icons.tag('download')"
                              ></span>
                              <span i18n:translate="">Download</span>
                            </a>
                          </tal:block>
                        </td>
                        <td>
                          <tal:block tal:condition="item/meeting_minutes_annexes">
                            <a class="btn btn-sm btn-outline-primary d-inline-flex align-items-center gap-1 rounded-pill px-3"
                               title="Download"
                               tal:attributes="
                                 href string:${item_url}/@@download/meeting_minutes_annexes;
                               "
                               i18n:attributes="title"
                            >
                              <span class="d-flex align-items-center"
                                    tal:content="structure python:icons.tag('download')"
                              ></span>
                              <span i18n:translate="">Download</span>
                            </a>
                          </tal:block>
                        </td>
                        <td class="text-center">
                          <a class="btn btn-sm btn-outline-danger d-inline-flex align-items-center gap-1 rounded-pill px-3"
                             title="View video"
                             tal:condition="item/video_url"
                             tal:attributes="
                               href item/video_url;
                             "
                             i18n:attributes="title"
                          >
                            <span class="d-flex align-items-center"
                                  tal:content="structure python:icons.tag('play-circle')"
                            ></span>
                            <span i18n:translate="">View video</span>
                          </a>
                        </td>
                        <td class="text-center pe-4">
                          <a class="btn btn-sm btn-outline-danger d-inline-flex align-items-center gap-1 rounded-pill px-3"
                             title="View video"
                             tal:condition="item/video_minutes_url"
                             tal:attributes="
                               href item/video_minutes_url;
                             "
                             i18n:attributes="title"
                          >
                            <span class="d-flex align-items-center"
                                  tal:content="structure python:icons.tag('play-circle')"
                            ></span>
                            <span i18n:translate="">View video</span>
                          </a>
                        </td>
                      </tal:item>
                    </tr>
                  </tbody>
                </table>

              </div>
            </div>
          </tal:repeat>

          <div class="alert alert-info d-flex align-items-center shadow-sm my-4"
               tal:condition="not:folders"
          >
            <span class="fs-4 me-3 d-flex align-items-center text-info"
                  tal:content="structure python:icons.tag('info-circle')"
            ></span>
            <p class="mb-0"
               i18n:translate=""
            >There is no data</p>
          </div>
        </tal:contents>

      </metal:block>
    </metal:content-core>
  </body>

</html>
