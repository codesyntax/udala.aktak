<html xmlns="http://www.w3.org/1999/xhtml"
      xmlns:i18n="http://xml.zope.org/namespaces/i18n"
      xmlns:metal="http://xml.zope.org/namespaces/metal"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      metal:use-macro="context/main_template/macros/master"
      i18n:domain="udala.aktak"
>

  <body>

    <metal:content-core fill-slot="content-core">
      <metal:block define-macro="content-core">

        <tal:contents tal:define="
                        bilkurak_items view/bilkurak_items;
                      ">
          <div class="table-responsive"
               tal:condition="bilkurak_items"
          >

            <table class="listing table"
                   id="bilkurak"
            >
              <thead>
                <tr>
                  <th i18n:translate="">Data</th>
                  <th i18n:translate="">Mota</th>
                  <th i18n:translate="">Akta</th>
                  <th i18n:translate="">Eranskinak</th>
                </tr>
              </thead>
              <tbody>
                <tr tal:repeat="item bilkurak_items">

                  <td tal:content="item/data">
                  2022/04/04 19:00
                  </td>
                  <td tal:content="item/mota">Ohikoa</td>
                  <td>
                    <tal:block tal:condition="item/akta">
                      <a href=""
                         tal:attributes="
                           href item/akta;
                         "
                         i18n:translate=""
                      >
                      Deskargatu
                      </a>
                    </tal:block>
                  </td>
                  <td>
                    <tal:block tal:condition="item/eranskinak">
                      <a href=""
                         tal:attributes="
                           href item/eranskinak;
                         "
                         i18n:translate=""
                      >
                      Deskargatu
                      </a>
                    </tal:block>
                  </td>
                </tr>
              </tbody>
            </table>

          </div>
          <p tal:condition="not:bilkurak_items"
             i18n:translate=""
          >
          Ez dago bilkuren daturik
          </p>
        </tal:contents>

      </metal:block>
    </metal:content-core>
  </body>

</html>
